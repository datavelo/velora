# ───────────────────────────────────────────────────────────
# FRONTEND (Public — safe for browser, inlined at build time)
# ───────────────────────────────────────────────────────────

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon public key (safe to expose)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Your deployed site URL (for SEO meta tags)
VITE_SITE_URL=https://velora-storefront.your-subdomain.workers.dev

# ───────────────────────────────────────────────────────────
# BACKEND (Secret — NEVER expose to browser, NEVER commit)
# Used by Cloudflare Worker via `wrangler secret put`
# ───────────────────────────────────────────────────────────

# Supabase project URL (same as above)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (FULL DATABASE ACCESS — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Your deployed site URL
SITE_URL=https://velora-storefront.your-subdomain.workers.dev
